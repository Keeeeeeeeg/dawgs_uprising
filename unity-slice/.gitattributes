# Dawgs Uprising: Unity port. Big or binary files go through Git LFS (the repo root already covers images, audio,
# fonts, .fbx and .blend). Scenes are in LFS too: they can't be merged, so claim a scene before editing it.
*.unity      filter=lfs diff=lfs merge=lfs -text
*.bytes      filter=lfs diff=lfs merge=lfs -text
*.raw        filter=lfs diff=lfs merge=lfs -text
*.exr        filter=lfs diff=lfs merge=lfs -text
*.fbx        filter=lfs diff=lfs merge=lfs -text
*.png        filter=lfs diff=lfs merge=lfs -text
*.jpg        filter=lfs diff=lfs merge=lfs -text
*.mp3        filter=lfs diff=lfs merge=lfs -text
*.wav        filter=lfs diff=lfs merge=lfs -text
*.blend      filter=lfs diff=lfs merge=lfs -text
# the meshes, terrain and LOD trees the Dawgs menus bake (tens of MB each)
Assets/Dawgs/Generated/**/*.asset filter=lfs diff=lfs merge=lfs -text
Assets/Dawgs/Generated/*.asset    filter=lfs diff=lfs merge=lfs -text
DawgsRig/rigsrc.json filter=lfs diff=lfs merge=lfs -text
